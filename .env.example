# EasyRun UI Agent 环境配置模板（复制为 .env 后按需修改）
# 配置优先级：命令行环境变量 > .env 文件 > 代码默认值
# 详细部署与配置文档见：http://127.0.0.1:8000/app/docs.html

# ---- LLM（必填）----
DEEPSEEK_API_KEY=sk-xxx
# 可选：自定义端点（OpenAI 兼容，可换本地 vLLM/Ollama）
# EASYRUN_DEEPSEEK_BASE_URL=https://api.deepseek.com
# EASYRUN_DEEPSEEK_CHAT_MODEL=deepseek-chat
# EASYRUN_DEEPSEEK_REASONER_MODEL=deepseek-reasoner

# ---- 数据库（三选一）----
# ① SQLite：留空即可，自动使用 data/easyrun.db（单机开发默认）
# EASYRUN_DATABASE_URL=
# ② PostgreSQL（生产推荐，需 pip install -e ".[postgres]"）：
#    建库：CREATE USER easyrun WITH PASSWORD '...'; CREATE DATABASE easyrun OWNER easyrun;
# EASYRUN_DATABASE_URL=postgresql+asyncpg://easyrun:密码@192.168.1.10:5432/easyrun
#    注意：密码含 @ : / 等特殊字符需 URL 编码（@→%40 :→%3A /→%2F #→%23）

# ---- 队列 ----
# 单机开发留空（进程内队列）；多机/多进程必配 Redis（需 pip install -e ".[redis]"）
# EASYRUN_REDIS_URL=redis://:密码@192.168.1.10:6379/0

# ---- 数据目录 ----
# 运行时数据（数据库/截图/Allure/浏览器内核），多机共享时指向 NFS 挂载点
# EASYRUN_DATA_DIR=./data

# ---- 执行 ----
EASYRUN_WORKERS=4                # 并发 Agent 数；纯 API/控制节点设 0
EASYRUN_BROWSER_HEADLESS=true
EASYRUN_MAX_ATTEMPTS=1           # 失败自动重试次数（1 = 只执行一次）
EASYRUN_TASK_TIMEOUT_SECONDS=600
EASYRUN_REPLAY_STEP_DELAY_MS=3000  # 固化回放动作间延迟

# ---- Allure（可选）----
# 留空自动探测 PATH / tools/bin/allure（bootstrap 已自动配置）
# EASYRUN_ALLURE_BIN=./tools/bin/allure
